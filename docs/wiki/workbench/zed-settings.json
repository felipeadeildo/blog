// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
    "enabled": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": false,
    "active_language_button": true
  },
  "relative_line_numbers": "disabled",
  "colorize_brackets": true,
  "lsp_document_colors": "inlay",
  "auto_signature_help": false,
  "scroll_beyond_last_line": "one_page",
  "markdown_preview_font_family": "Noto Sans",
  "buffer_font_weight": 350.0,
  "default_open_behavior": "new_window",
  "proxy": "",
  "diff_view_style": "split",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "effort": "medium"
      },
      "type": "registry"
    }
  },
  "disable_ai": true,
  "base_keymap": "VSCode",
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "terminal": {
    "button": true,
    "font_family": "JetBrainsMono Nerd Font Mono",
    "default_height": 350.0,
    "font_size": 13.0,
    "dock": "right"
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "write_file": {
          "default": "allow",
        },
      },
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.2-codex",
      "enable_thinking": false,
    },
    "default_profile": "write",
    "dock": "right",
    "default_height": 400,
    "default_model": {
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
    },
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },
  "git_panel": {
    "collapse_untracked_diff": true,
    "dock": "left",
    "tree_view": false,
  },
  "file_finder": {
    "modal_max_width": "medium",
  },
  "project_panel": {
    "git_status_indicator": false,
    "diagnostic_badges": false,
    "folder_indicator": "icon",
    "entry_spacing": "standard",
    "dock": "left",
    "hide_root": true,
    "auto_fold_dirs": true,
    "indent_size": 13.0,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "title_bar": {
    "button_layout": "",
    "show_menus": false,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_onboarding_banner": true,
    "show_branch_status_icon": true,
  },
  "seed_search_query_from_cursor": "always",
  "centered_layout": {
    "right_padding": 0.1,
    "left_padding": null,
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.7,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "git": {
    "path_style": "file_name_first",
    "hunk_style": "staged_hollow",
    "branch_picker": {
      "show_author_name": true
    },
    "blame": {
      "show_avatar": true
    },
    "git_gutter": "tracked_files",
    "diff_base": "head",
    "inline_blame": {
      "min_column": 0,
      "location": "inline",
      "show_commit_summary": false,
      "padding": 1,
    },
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "none",
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "padding": 1,
      "enabled": true,
    },
  },
  "show_whitespaces": "trailing",
  "allow_rewrap": "in_comments",
  "toolbar": {
    "code_actions": false,
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "breakpoints": true,
    "runnables": true,
    "git_gutter_width": {
      "custom": 5.0
    },
    "line_numbers": true,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "indent_aware",
  },
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "diagnostics": "all",
    "selected_symbol": true,
  },
  "use_smartcase_search": true,
  "autoscroll_on_clicks": true,
  "scroll_sensitivity": 2.0,
  "autosave": "on_focus_change",
  "cursor_shape": "bar",
  "buffer_line_height": "comfortable",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_features": { "calt": true, "liga": true },
  "preferred_line_length": 80,
  "show_wrap_guides": false,
  "unnecessary_code_fade": 0.4,
  "hide_mouse": "never",
  "soft_wrap": "editor_width",
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "bottom_dock_layout": "left_aligned", // espaço que terminal ocupa.
  "ui_font_size": 17.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "DankShell Light",
    "dark": "DankShell Dark Transparent",
  },
  "languages": {
    "Python": {
      "tab_size": 4,
      "format_on_save": "on",
      "colorize_brackets": true,

      "language_servers": [
        // Enable ty and ruff,
        // Other built-in servers (basedpyright, pyright, pylsp)
        // are disabled by being omitted from this list.
        "ty",
        "ruff",
      ],
    },
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "inlay_hints": { "enabled": false },
    },
    "TSX": { "inlay_hints": { "enabled": false } },
  },
  "lsp": {},
}
